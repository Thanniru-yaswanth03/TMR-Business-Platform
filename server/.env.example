# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Security & CORS Configuration
# In production, set to exact frontend domain (e.g., https://tmrservices.in)
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tmr_business_platform?retryWrites=true&w=majority

# Rate Limiting Configuration (requests per 15 minutes window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Single-Admin Authentication Configuration (Sprint 7)
# Set your secure admin username and initial password (or pre-hashed bcrypt string)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_PASSWORD_HASH=
JWT_SECRET=your_long_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_NAME=tmr_admin_token
